{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: offline (8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/server",
      "env": { "OFFLINE": "1" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Server: LLM (8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/server",
      "env": { "LLM_API_KEY": "${env:LLM_API_KEY}" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
